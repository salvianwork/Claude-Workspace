{
  "name": "video-templates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remotion scene templates for the video agent team",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/index.ts",
