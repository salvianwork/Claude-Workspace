    "render": "remotion render src/index.ts Video --muted"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "lucide-react": "1.68.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "zod": "4.5.4",
    "@remotion/fonts": "4.0.539",
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/merriweather": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
